##############################################
#         ADAM WhatsApp Bot — config.env     #
##############################################

# ── Core Session ──────────────────────────────────────────
SESSION_ID="adam_sessionid"
PREFIX="."
SUDO=""                     # Comma-separated owner numbers (e.g. 263XXXXXXXXX)

# ── Bot Behaviour ─────────────────────────────────────────
VPS="true"                  # Set "true" when running on a server
AUTO_UPDATE="true"          # Auto-update plugins from GitHub
ALWAYS_ONLINE="false"       # Keep bot presence as "online" always
SEND_READ="false"           # Send read receipts
AUTO_STATUS_VIEW="false"    # Auto-view status updates
DISABLE_BOT="false"         # Temporarily disable command processing
DISABLE_START_MESSAGE="false"

# ── Language ──────────────────────────────────────────────
BOT_LANG="en"               # Bot language (en, fr, es, pt, ar, ...)
LANG="en"

# ── Sticker ───────────────────────────────────────────────
STICKER_PACKNAME="⚡,ADAM"  # Format: "pack,author"

# ── Moderation ────────────────────────────────────────────
WARN_LIMIT="3"
ANTILINK_MSG="⚠️ Links are not allowed in this group."
ANTISPAM_MSG="⚠️ Spamming is not allowed in this group."
ANTIWORDS_MSG="⚠️ That word is not allowed in this group."
ANTIWORDS=""                # Comma-separated banned words
ANTI_DELETE="false"
DELETE_TYPE="1"             # 1=notify, 2=repost

# ── Calls ─────────────────────────────────────────────────
REJECT_CALL="false"

# ── Anti-Bot ──────────────────────────────────────────────
ANTI_BOT="false"
ANTI_BOT_MESSAGE="Bots are not allowed in this group."

# ── Warn Messages ─────────────────────────────────────────
WARN_MESSAGE="⚠️ Warning {warn}/{limit} — {reason}"
WARN_RESET_MESSAGE="✅ Your warnings have been reset."
WARN_KICK_MESSAGE="🚫 You have been removed after {limit} warnings."

# ── Personal Mode ─────────────────────────────────────────
PERSONAL_MESSAGE="false"    # Only respond to owner in private chats
MENTION="false"             # Respond when mentioned

# ── Upload / Media ────────────────────────────────────────
MAX_UPLOAD="200"            # Max upload size in MB
RMBG_KEY=""                 # Remove.bg API key

# ── External Services ─────────────────────────────────────
BRAINSHOP=""                # Brainshop.io API key (AI fallback)
TRUECALLER=""               # Truecaller API key

# ── AI Providers ──────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

GROQ_API_KEY=""
GROQ_MODEL="llama3-70b-8192"

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini:free"

GPT=""                      # OpenAI API key (legacy)
MODEL="gpt-3.5-turbo"

BING_COOKIE=""

# ── Group ─────────────────────────────────────────────────
APPROVE="false"             # Auto-approve join requests
AJOIN="false"               # Auto-join via invite links
GROUP_ADMINS=""             # Comma-separated group admin JIDs
FORCE_LOGOUT="false"

# ── Logging ───────────────────────────────────────────────
LOG_MSG="true"              # Log incoming messages
BAILEYS_LOG_LVL="silent"    # Baileys internal log level (silent/fatal/error/warn/info/debug/trace)

# ── Timezone ──────────────────────────────────────────────
TIMEZONE="Africa/Harare"

# ── Reactions ─────────────────────────────────────────────
CMD_REACTION="true"         # React with emoji when a command is run

# ── White List ────────────────────────────────────────────
WHITE_LIST=""               # Comma-separated JIDs always allowed

# ── YouTube ───────────────────────────────────────────────
YT_COOKIE=""                # YouTube cookie for age-restricted content

# ── Koyeb Deployment ──────────────────────────────────────
KOYEB="false"
KOYEB_NAME=""
KOYEB_API=""

# ── Render Deployment ─────────────────────────────────────
RENDER_NAME=""
RENDER_API_KEY=""

# ── API Mode ──────────────────────────────────────────────
# API_MODE: "bot"  — only run the WhatsApp bot
#           "api"  — only run the REST API server
#           "both" — run both (default)
API_MODE="both"
API_KEY=""                  # Secret key to authenticate API requests
API_WEBHOOK_URL=""          # URL to forward incoming messages as webhooks
API_PUBLIC_URL=""           # Your public URL (used in webhooks)
PORT="3000"

# ── List / UI Type ────────────────────────────────────────
LIST_TYPE="1"               # 1=buttons, 2=list (where supported)
